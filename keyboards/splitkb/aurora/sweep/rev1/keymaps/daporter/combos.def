// clang-format off

//   name        result               chord keys

// top row
COMB(combo_AREP, QK_AREP,             LB_LT2, LB_RT2)
COMB(combo_REP,  QK_REP,              LB_LT1, LB_RT1)

// top-middle vertical combos
COMB(combo_ESC,  KC_ESCAPE,           LB_LT4, LB_LM4)
COMB(combo_BSWD, LCTL(KC_BACKSPACE),  LB_LT3, LB_LM3)
COMB(combo_BSPC, KC_BACKSPACE,        LB_LT2, LB_LM2)
COMB(combo_DEL,  KC_DELETE,           LB_LT1, LB_LM1)
COMB(combo_STAB, LSFT(KC_TAB),        LB_RT1, LB_RM1)
COMB(combo_ENT,  KC_ENTER,            LB_RT2, LB_RM2)
COMB(combo_TAB,  KC_TAB,              LB_RT3, LB_RM3)

// middle row

// middle-bottom row vertical combos
COMB(combo_UNDO, LCTL(KC_Z),          LB_LM4, LB_LB4)
COMB(combo_REDO, LCTL(LSFT(KC_Z)),    LB_LM3, LB_LB3)

// bottom row

// clang-format on
