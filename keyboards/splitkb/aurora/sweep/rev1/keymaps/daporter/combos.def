// clang-format off
//   name        result               chord keys
COMB(combo_BSPC, KC_BACKSPACE,        HD_LT3, HD_LT2)
COMB(combo_HD_Z, KC_Z,                HD_LT2, HD_LT1)
COMB(combo_HD_Q, LP_QU,               HD_LT1, HD_LT3) // temporary; LT3+LT2 is now combo_BSPC
COMB(combo_AREP, QK_AREP,             HD_LT2, HD_RT2)
COMB(combo_REP,  QK_REP,              HD_LT1, HD_RT1)
COMB(combo_STAB, LSFT(KC_TAB),        HD_LM3, HD_LM2, HD_LM1)
COMB(combo_ESC,  KC_ESCAPE,           HD_LM3, HD_LM2)
COMB(combo_TAB,  KC_TAB,              HD_LM2, HD_LM1)
COMB(combo_REDO, LCTL(LSFT(KC_Z)),    HD_LB4, HD_LB3, HD_LB2)
COMB(combo_UNDO, LCTL(KC_Z),          HD_LB4, HD_LB3)
COMB(combo_AT,   KC_AT,               HD_RT0, HD_RT1)
COMB(combo_EXLM, KC_EXCLAIM,          HD_RT1, HD_RT2)
COMB(combo_COLN, KC_COLON,            HD_RT1, HD_RT3)
COMB(combo_SCLP, LCTL(LSFT(KC_PSCR)), HD_RT2, HD_RT3, HD_RT4) // SCREEN shot SELECTION to clipboard
COMB(combo_QUES, KC_QUESTION,         HD_RT2, HD_RT3)
COMB(combo_DOLR, KC_DOLLAR,           HD_RT2, HD_RT4)
COMB(combo_SCAP, LSFT(KC_PSCR),       HD_RT3, HD_RT4)         // SCREEN shot SELECTION to file
COMB(combo_SCLN, KC_SEMICOLON,        HD_RM0, HD_RM1)
COMB(combo_ENT,  KC_ENTER,            HD_RM1, HD_RM2, HD_RM3)
COMB(combo_CX,   LCTL(KC_X),          HD_RM1, HD_RM2)
COMB(combo_MX,   LALT(KC_X),          HD_RM1, HD_RM3)
COMB(combo_LSQO, UC(0x2018),          HD_RM2, HD_RM3)         // left single quote, hold for left double quote
COMB(combo_RSQO, UC(0x2019),          HD_RM3, HD_RM4)         // right single quote, hold for right double quote
COMB(combo_NDSH, UC(0x2013),          HD_RB0, HD_RB1)         // en dash, hold for em dash (see tap_hold in keymap.c)
COMB(combo_UNDS, KC_UNDERSCORE,       HD_RB1, HD_RB3)
COMB(combo_TILD, KC_TILDE,            HD_RB1, HD_RB4)
COMB(combo_EQL,  KC_EQUAL,            HD_RB2, HD_RB3)
// clang-format on
