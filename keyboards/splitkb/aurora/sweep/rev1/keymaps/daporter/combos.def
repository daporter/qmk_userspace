// clang-format off

//   name        result               chord keys

// top row
COMB(combo_AREP, QK_AREP,             HD_LT2, HD_RT2)
COMB(combo_REP,  QK_REP,              HD_LT1, HD_RT1)

// top-middle vertical combos
COMB(combo_ESC,  KC_ESCAPE,           HD_LT4, HD_LM4)
COMB(combo_BSWD, LCTL(KC_BACKSPACE),  HD_LT3, HD_LM3)
COMB(combo_BSPC, KC_BACKSPACE,        HD_LT2, HD_LM2)
COMB(combo_DEL,  KC_DELETE,           HD_LT1, HD_LM1)
COMB(combo_STAB, LSFT(KC_TAB),        HD_RT1, HD_RM1)
COMB(combo_ENT,  KC_ENTER,            HD_RT2, HD_RM2)
COMB(combo_TAB,  KC_TAB,              HD_RT3, HD_RM3)

// middle row

// middle-bottom row vertical combos
COMB(combo_UNDO, LCTL(KC_Z),          HD_LM4, HD_LB4)
COMB(combo_REDO, LCTL(LSFT(KC_Z)),    HD_LM3, HD_LB3)

// bottom row

// clang-format on
